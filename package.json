    "research:world-model-expedition:v2": "node experiments/world-model-expedition/scripts/run_expedition_v2.mjs",
    "research:pilot-rhyme-expedition": "node research/pilot-rhyme-expedition/scripts/run_empirical_pipeline.mjs",
