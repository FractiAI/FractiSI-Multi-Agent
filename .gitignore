# Environments and tool caches
.venv/
.venv-cuda/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.env
.DS_Store
.vercel

# Per-machine customer receipts: results and contact details stay on this machine.
benchmarks/reports/*
!benchmarks/reports/README.md
!benchmarks/reports/AGENTS.md

# Renderer intermediates and logs. Final PDFs, the web edition, figures, data, reports and
# hydrated sections are evidence and tracked, as in the template exemplars.
output/pdf/*
!output/pdf/*_combined.pdf
!output/pdf/README.md
!output/pdf/AGENTS.md
# Diagnostics carry this machine's absolute paths.
output/reports/diagnostics.json
output/logs/
output/slides/
output/citations/
output/.pipeline/

# Session-local agent caches
.claude/
graft/
